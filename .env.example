# Local development. Copy this file to .env; the app loads it automatically.
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000
ADMIN_USERNAME=admin
# Leave these blank for local development defaults only.
SECRET_KEY=
ADMIN_PASSWORD_HASH=
# For a local Supabase connection, replace the placeholder values below with your
# real project URL. Example format:
# DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# If left blank, the app falls back to a local SQLite database in instance/admin.db.
DATABASE_URL=
# PODs and invoices share the same Supabase project/server key. Use the base
# project URL (https://PROJECT_REF.supabase.co), without /rest/v1/.
# Both blank means local development uploads in instance/uploads. Set both for
# remote storage; incomplete/broken remote settings reject uploads, with no local fallback.
SUPABASE_URL=
SUPABASE_KEY=
# Create these private buckets in Supabase Storage. Invoices use their own bucket
# through the same upload/download/replace/remove flow as PODs.
SUPABASE_BUCKET=pod-uploads
SUPABASE_INVOICE_BUCKET=invoice-uploads
# Optional shared request-limit storage (for example redis://localhost:6379/0).
RATELIMIT_STORAGE_URI=
