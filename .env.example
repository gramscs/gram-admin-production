# Copy to .env and configure PostgreSQL and Supabase before starting the app.
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000
ADMIN_USERNAME=admin
SECRET_KEY=
ADMIN_PASSWORD_HASH=
# PostgreSQL connection string. Supabase connections require SSL.
DATABASE_URL=
# Supabase project URL and server-side key for private document storage.
SUPABASE_URL=
SUPABASE_KEY=
# Create these private buckets in Supabase Storage.
SUPABASE_BUCKET=pod-uploads
SUPABASE_INVOICE_BUCKET=invoice-uploads
# Lorry receipts use the existing private POD bucket by default.
SUPABASE_LR_BUCKET=
# Saved MIS reports use a separate private bucket.
SUPABASE_MIS_BUCKET=mis-reports
# Optional shared request-limit storage (for example redis://localhost:6379/0).
RATELIMIT_STORAGE_URI=
